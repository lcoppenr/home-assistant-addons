#!/usr/bin/with-contenv bash
# Render /etc/alloy/config.alloy from the add-on options before Alloy starts.
#
# Adapted from castlerogers/ha-addon-alloy (MIT), relabelled to match the
# Purplesky Loki conventions: containers carry `container`, everything else
# carries `service`, and every stream carries `host`.
set -euo pipefail

CONFIG_DIR="/etc/alloy"
CONFIG_FILE="${CONFIG_DIR}/config.alloy"
OPTIONS_FILE="${OPTIONS_FILE:-/data/options.json}"

mkdir -p "${CONFIG_DIR}" /data/alloy

LOKI_URL=$(jq -r '.loki_url' "${OPTIONS_FILE}")
HOST_LABEL=$(jq -r '.host_label // "homeassistant"' "${OPTIONS_FILE}")
LOG_LEVEL=$(jq -r '.log_level // "info"' "${OPTIONS_FILE}")

# Each excluded syslog identifier becomes an anchored drop rule. Supervisor
# 2026.07 renamed add-on identifiers from addon_<hash>_<slug> to
# app_<hash>_<slug>; accept either prefix so a rule keeps matching.
DROP_RULES=""
EXCLUDED_IDS=""
while IFS= read -r ident; do
    [ -z "${ident}" ] && continue
    EXCLUDED_IDS="${EXCLUDED_IDS} ${ident}"
    case "${ident}" in
        addon_*) pattern="(addon|app)_${ident#addon_}" ;;
        app_*) pattern="(addon|app)_${ident#app_}" ;;
        *) pattern="${ident}" ;;
    esac
    DROP_RULES="${DROP_RULES}
  rule {
    source_labels = [\"__journal_syslog_identifier\"]
    regex         = \"${pattern}\"
    action        = \"drop\"
  }"
done < <(jq -r '.exclude_syslog_identifiers[]? // empty' "${OPTIONS_FILE}")

# Persistent journal if the host keeps one, otherwise the volatile one.
JOURNAL_PATH="/var/log/journal"
if [ ! -d "${JOURNAL_PATH}" ] || [ -z "$(ls -A "${JOURNAL_PATH}" 2>/dev/null)" ]; then
    JOURNAL_PATH="/run/log/journal"
fi

echo "-----------------------------------------------------------"
echo " Grafana Alloy journal shipper"
echo " Loki URL:     ${LOKI_URL}"
echo " host label:   ${HOST_LABEL}"
echo " Journal path: ${JOURNAL_PATH}"
echo " Log level:    ${LOG_LEVEL}"
echo " Excluded ids:${EXCLUDED_IDS:- (none)}"
echo "-----------------------------------------------------------"

# The config is written from quoted heredocs (no shell expansion, so Alloy's
# own $1 and \s stay literal) with @PLACEHOLDERS@ filled in afterwards.
{
cat <<'ALLOY'
// Generated by the Alloy journal add-on on every start.
// Configure it from the add-on's Configuration tab, not here.

logging {
  level = "@LOG_LEVEL@"
}

// Host systemd journal: Home Assistant Core, Supervisor, every add-on,
// Docker and the host OS (mounted by the Supervisor via journald: true).
loki.source.journal "journal" {
  path          = "@JOURNAL_PATH@"
  max_age       = "12h"
  forward_to    = [loki.process.journal.receiver]
  relabel_rules = loki.relabel.journal.rules
  labels        = {
    host = "@HOST_LABEL@",
    job  = "systemd-journal",
  }
}

loki.relabel "journal" {
  forward_to = []

  // Containers (HA Core "homeassistant", Supervisor "hassio_supervisor",
  // add-ons "addon_<hash>_<slug>") get `container`, like Docker hosts.
  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "container"
  }

  // Everything else gets `service`: the systemd unit without ".service",
  // or the syslog identifier when there is no unit (kernel, etc.).
  rule {
    source_labels = ["__journal_container_name", "__journal_syslog_identifier"]
    separator     = "@"
    regex         = "@(.+)"
    target_label  = "service"
    replacement   = "$1"
  }
  rule {
    source_labels = ["__journal_container_name", "__journal__systemd_unit"]
    separator     = "@"
    regex         = "@(.+?)(\\.service)?"
    target_label  = "service"
    replacement   = "$1"
  }

  // Journal priority is real severity only for non-container entries.
  // Docker's journald driver stamps it from the stream (stdout = info,
  // stderr = err), so for containers it becomes `stream`, not `level`.
  rule {
    source_labels = ["__journal_container_name", "__journal_priority_keyword"]
    separator     = "@"
    regex         = "@(.*)"
    target_label  = "level"
    replacement   = "$1"
  }
  rule {
    source_labels = ["__journal_container_name", "__journal_priority_keyword"]
    separator     = "@"
    regex         = ".+@info"
    target_label  = "stream"
    replacement   = "stdout"
  }
  rule {
    source_labels = ["__journal_container_name", "__journal_priority_keyword"]
    separator     = "@"
    regex         = ".+@(err|error)"
    target_label  = "stream"
    replacement   = "stderr"
  }
ALLOY
printf '%s\n' "${DROP_RULES}"
cat <<'ALLOY'
}

loki.process "journal" {
  // Drop blank lines.
  stage.drop {
    expression = "^\\s*$"
  }

  forward_to = [loki.write.loki.receiver]
}

// Loki push API directly; never the syslog port, so HA logs stay out of
// anything that forwards syslog onward.
loki.write "loki" {
  endpoint {
    url = "@LOKI_URL@"
  }
}
ALLOY
} | sed \
    -e "s|@LOG_LEVEL@|${LOG_LEVEL}|" \
    -e "s|@JOURNAL_PATH@|${JOURNAL_PATH}|" \
    -e "s|@HOST_LABEL@|${HOST_LABEL}|" \
    -e "s|@LOKI_URL@|${LOKI_URL}|" \
    > "${CONFIG_FILE}"

echo "Alloy config generated at ${CONFIG_FILE}"
